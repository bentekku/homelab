# =============================================================
# SIRIUS — Homelab .env
# Custom build | NVIDIA RTX 2070 Super | 16GB RAM 
# =============================================================

# General
TZ=Asia/Kolkata

# =============================================================
# IMMICH 
# =============================================================
# Immich version
IMMICH_VERSION=v2.7.5
# Immich paths
UPLOAD_LOCATION=/mnt/homelab/server/data/immich/library
DB_DATA_LOCATION=./docker-data/postgres/
# Immich DB
DB_PASSWORD=TxUbfytZC3
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# DB_HOST=immich-db
# REDIS_HOST=immich-redis

# =============================================================
# FEISHIN (points to Jellyfin running on the same machine)
# =============================================================
FEISHIN_SERVER_NAME=Jellyfin
FEISHIN_SERVER_TYPE=jellyfin
# Change to your actual Jellyfin URL (LAN IP or domain)
FEISHIN_SERVER_URL=http://100.78.247.41:8096
# When true, users can only change username/password, not server settings
FEISHIN_SERVER_LOCK=true

# =============================================================
# OPENCLOUD
# Replace with Sirius's actual Tailscale hostname after joining tailnet.
# Run: tailscale status  — to find it.
# Then run: tailscale serve --bg http://localhost:9200
# =============================================================
OC_INSECURE=false
# Change to your actual server URL (LAN IP or domain)
OC_CONFIG_DIR=/mnt/homelab/server/config/opencloud
OC_DATA_DIR=/mnt/homelab/server/data/opencloud
OC_TAILSCALE_HOSTNAME=sirius.hyena-fujita.ts.net
OC_URL=https://sirius.hyena-fujita.ts.net