# =============================================================
# CORVUS — Homelab .env
# HP 245 G4 | Ubuntu Server 26.04 LTS | AMD Radeon R5 (iGPU)
# =============================================================

# General
TZ=Asia/Kolkata

# Corvus's static LAN IP (assign a static IP on your router for this!)
# Example: 192.168.1.100 — check your ZTE router's DHCP table
CORVUS_LAN_IP=192.168.1.201   # <-- CHANGE THIS

# =============================================================
# JELLYFIN
# =============================================================
JELLYFIN_CONFIG_DIR=/opt/homelab/config/jellyfin
JELLYFIN_MUSIC_DIR=/opt/homelab/data/music

# =============================================================
# FEISHIN (points to Jellyfin running on the same machine)
# =============================================================
FEISHIN_SERVER_NAME=Jellyfin
FEISHIN_SERVER_TYPE=jellyfin
FEISHIN_SERVER_URL=http://localhost:8096         # Local — no Tailscale IP needed
FEISHIN_SERVER_LOCK=true

# =============================================================
# OPENCLOUD
# Replace with Corvus's actual Tailscale hostname after joining tailnet.
# Run: tailscale status  — to find it.
# Then run: tailscale serve --bg http://localhost:9200
# to set up HTTPS termination (same as Sirius setup).
# =============================================================
OC_URL=https://corvus.hyena-fujita.ts.net       # <-- CHANGE to Corvus's actual Tailscale hostname
OC_CONFIG_DIR=/opt/homelab/config/opencloud
OC_DATA_DIR=/opt/homelab/data/opencloud

# =============================================================
# WATCHDOG — Downtime alerter (Jellyfin + Pi-hole → ntfy)
# Create this ntfy user after first run:
#   docker exec -it ntfy ntfy user add watchdog
# Use the same credentials here.
# =============================================================
WATCHDOG_NTFY_TOPIC=homelab-alerts              # ntfy topic — subscribe to this in the app
WATCHDOG_NTFY_USER=watchdog                     # ntfy user for the watchdog (create via docker exec)
WATCHDOG_NTFY_PASS=changeme                     # <-- CHANGE THIS
WATCHDOG_INTERVAL=60                            # Check interval in seconds (60 = once per minute)

# =============================================================
# NTFY — Push notifications
# Replace with Corvus's Tailscale hostname if serving over Tailscale,
# or use LAN IP for local-only access.
# =============================================================
NTFY_BASE_URL=http://192.168.1.100:9090         # <-- CHANGE: use LAN IP or Tailscale URL
NTFY_CACHE_DIR=/opt/homelab/config/ntfy/cache   # Message cache (survives restarts)
NTFY_DATA_DIR=/opt/homelab/config/ntfy/data     # Auth database
NTFY_CACHE_DURATION=24h                         # Message cache duration (default was 12h)
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh          # iOS instant push relay (content stays on Corvus)    


# =============================================================
# PI-HOLE
# =============================================================
PIHOLE_WEBPASSWORD=changeme                    # <-- CHANGE THIS — Pi-hole dashboard password
PIHOLE_CONFIG_DIR=/opt/homelab/config/pihole
PIHOLE_UPSTREAM_DNS_1=1.1.1.1                   # Cloudflare DNS (fast, privacy-respecting)
PIHOLE_UPSTREAM_DNS_2=1.0.0.1                   # Cloudflare DNS fallback
# Alternatives if you prefer:
# PIHOLE_UPSTREAM_DNS_1=8.8.8.8   # Google DNS
# PIHOLE_UPSTREAM_DNS_1=9.9.9.9   # Quad9 (security-focused, good for India)